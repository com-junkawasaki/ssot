# File ID - Generate a unique ID using `capnp id` or similar
@0xcafebabe12345678; # Example ID, replace with a real one

# Add rust_out annotation
$rust_out("src/generated");
# Add Cap'n Proto and TypeScript output annotations for testing
$capnp_out("target/generated/capnp");
$ts_out("target/generated/ts");

# package com.example.lightswitch; # Optional package declaration

$description("A simple light switch FSM.");
stateMachine LightSwitch {
    $initial(Off);
    # $description("A simple light switch FSM."); # (restore value)

    states {
        $description("Initial state, waiting for input.");
        Idle @0 {
            entry: log_idle_entry;
        };
        $description("Processing input actively.");
        Running @1 {
            entry: start_processing;
            exit: stop_processing;
        };
        // Suspended @2; // Example without entry/exit - TEMPORARILY COMMENTED OUT DUE TO PARSE ERROR
        $description("Final state after completion or error.");
        Done @3 {
            entry: log_completion;
        };
        $description("The light is off.");
        Off @4;
        $description("The light is on.");
        On @5;
    }

    events {
        $description("Toggles the light state.");
        event Toggle @0 { # Empty 
        }
        $description("Turns the light on with a specific brightness.");
        event TurnOn @1 {
            $description("Brightness level (0-255).");
            brightness @0 : UInt8; # Event with payload
        }
        $description("Turns the light off.");
        event TurnOff @2 { # Empty 
        }
    }

    transitions {
        transition ToggleOffToOn from Off to On {
            on @0 Toggle;
            action @1 activate_light;
        }
        transition ToggleOnToOff from On to Off {
            on @0 Toggle;
            action @1 deactivate_light;
        }

        # Specific TurnOn/TurnOff transitions
        # Giving them distinct names even though from/to are the same as above
        # clarifies intent and satisfies the grammar.
        transition SpecificTurnOn from Off to On {
            on @1 TurnOn;
            action @1 activate_light_specific; # Different action
        }
        transition SpecificTurnOff from On to Off {
            on @2 TurnOff;
            action @1 deactivate_light_specific; # Different action
        }

        # Example self-transition with guard (uncomment events/transitions if needed)
        # transition GuardedOn from On to On {
        #     on @3 CheckBrightness;
        #     guard @1 is_already_max_brightness;
        # }
    }
}