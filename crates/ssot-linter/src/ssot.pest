// crates/ssot-linter/src/ssot.pest

// Rule to skip whitespace and comments implicitly
WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT = _{ "//" ~ (!NEWLINE ~ ANY)* ~ NEWLINE | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// Atomic Tokens
identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
string_literal = @{ "\"" ~ (("\\\"\"" | "\\\\" | !("\"" | "\\")) ~ ANY)* ~ "\"" }

// State Definition
state_keyword = { "state" }
state_name = { identifier }
action_call = { identifier ~ "(" ~ (string_literal ~ ("," ~ string_literal)*)? ~ ")" } // Simplified action call for now
entry_action = { "entry" ~ ":" ~ action_call ~ ";" }
exit_action = { "exit" ~ ":" ~ action_call ~ ";" }
state_body_content = { entry_action | exit_action } // Content inside {}
state_body = { "{" ~ state_body_content* ~ "}" } // Allow zero or more actions
state_def = { state_keyword ~ state_name ~ state_body? ~ ";" } // Body is optional

// Transition Definition
transition_keyword = { "transition" }
event_name = { identifier }
from_state = { identifier }
to_state = { identifier }
transition_def = { transition_keyword ~ event_name ~ ":" ~ from_state ~ "->" ~ to_state ~ ";" }

// Top-level
definition = { state_def | transition_def }
ssot_file = { SOI ~ definition* ~ EOI } // Only definitions expected at top level after skipping whitespace/comments

// ... rest of the file remains unchanged ... 