/*
 * Pest grammar for the .ssot language
 */

// Basic Whitespace and Comments
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (COMMENT | !"*/" ~ ANY)* ~ "*/" }
inner = _{ !(COMMENT | WHITESPACE) ~ ANY }

// Basic Tokens
IDENTIFIER = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
STRING_LITERAL = @{ "\"" ~ ("\\" | !"\"" ~ ANY)* ~ "\"" }
INTEGER_LITERAL = @{ "-"? ~ ASCII_DIGIT+ }

// --- Float Literal Components ---
sign = { "+" | "-" }
exp_char = { "e" | "E" }
exponent = { exp_char ~ sign? ~ ASCII_DIGIT+ }
FLOAT_LITERAL = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ exponent? }

BOOLEAN_LITERAL = @{ "true" | "false" }
DURATION_LITERAL = @{ INTEGER_LITERAL ~ ("ms" | "s" | "m" | "h") }
NULL_LITERAL = @{ "null" }

// Basic Types
primitive_type = { "string" | "number" | "boolean" | "integer" | "float" | "any" | "void" }
list_type = { "List" ~ "<" ~ type_ref ~ ">" }
map_type = { "Map" ~ "<" ~ type_ref ~ "," ~ type_ref ~ ">" }
type_ref = { (primitive_type | list_type | map_type | IDENTIFIER) ~ "?"? }

// Annotations
annotation = { "$" ~ IDENTIFIER ~ annotation_args? ~ ";"? }
annotation_args = { "(" ~ (annotation_arg ~ ("," ~ WHITESPACE* ~ annotation_arg)*)? ~ ")" }
annotation_arg = { (IDENTIFIER ~ ":")? ~ WHITESPACE* ~ annotation_value }
annotation_value = { literal_value | list_literal | object_literal }

// Literals for Annotation Values
list_literal = { "[" ~ (annotation_value ~ ("," ~ WHITESPACE* ~ annotation_value)*)? ~ "]" }
object_literal = { "{" ~ (argument_pair ~ ("," ~ WHITESPACE* ~ argument_pair)*)? ~ "}" }
argument_pair = { IDENTIFIER ~ ":" ~ WHITESPACE* ~ annotation_value }
literal_value = { STRING_LITERAL | INTEGER_LITERAL /*| FLOAT_LITERAL*/ | BOOLEAN_LITERAL /*| DURATION_LITERAL | NULL_LITERAL*/ | IDENTIFIER /* For enums/constants */ }

// Top Level Structure
file = { SOI ~ (COMMENT | WHITESPACE | import_statement | top_level_block)* ~ EOI }

// --- Imports ---
import_statement = { "import" ~ STRING_LITERAL ~ ";"? }

// --- Top Level Blocks (Replaces top_level_definition) ---
top_level_block = _{ annotation* ~ (types_block | machines_block | services_block | communication_block | actors_block | deployment_config_block) }

// --- Types Block ---
types_block = { "types" ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | type_definition)* ~ WHITESPACE* ~ "}" }
type_definition = _{ annotation* ~ (struct_definition | enum_definition) }

// --- Struct Definition ---
struct_definition = { "struct" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | field_definition)* ~ WHITESPACE* ~ "}" }
field_definition = { IDENTIFIER ~ ":" ~ WHITESPACE* ~ type_specifier ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ annotation* ~ ";"? }

// --- Enum Definition ---
enum_definition = { "enum" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | enum_variant)* ~ WHITESPACE* ~ "}" }
enum_variant = { IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ ("{" ~ WHITESPACE* ~ annotation* ~ WHITESPACE* ~ "}")? ~ ";"? }

// --- Machines Block ---
machines_block = { "machines" ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | machine_definition)* ~ WHITESPACE* ~ "}" }
machine_definition = { "machine" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ machine_body? ~ WHITESPACE* ~ "}" }
machine_body = { (COMMENT | WHITESPACE | annotation | machine_element)* }
machine_element = _{ context_definition | states_block | actions_block | guards_block | invokes_block }

// --- Machine Elements ---
context_definition = { "context" ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | context_field_definition)* ~ WHITESPACE* ~ "}" }
context_field_definition = { IDENTIFIER ~ ":" ~ WHITESPACE* ~ type_specifier ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ annotation* ~ ";"? }

states_block = { "states" ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | state_definition)* ~ WHITESPACE* ~ "}" }
state_definition = { "state" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ state_body? }
state_body = _{ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | state_element)* ~ WHITESPACE* ~ "}" | ";" }
state_element = _{ states_block
                 | transition_definition
                 | state_invoke
                 | history_definition }

// --- Transition Definition ---
transition_definition = { ("on" ~ WHITESPACE*)? ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ transition_target_specifier ~ WHITESPACE* ~ ";"? }
transition_target_specifier = { "target" ~ WHITESPACE* ~ target_identifier ~ WHITESPACE* ~ transition_details? }
target_identifier = { IDENTIFIER | ("." ~ "history") | (IDENTIFIER ~ "." ~ "history") }
transition_details = { "{" ~ WHITESPACE* ~ (transition_detail_item ~ (","? ~ WHITESPACE* ~ transition_detail_item)*)? ~ WHITESPACE* ~ "}" }
transition_detail_item = _{ transition_action | transition_guard /* | Add other details like allowed_actors later */ }
transition_action = { "action" ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ (IDENTIFIER | action_list) }
action_list = { "[" ~ WHITESPACE* ~ (IDENTIFIER ~ ("," ~ WHITESPACE* ~ IDENTIFIER)*)? ~ WHITESPACE* ~ "]" }
transition_guard = { "guard" ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ (guard_specifier | guard_list) }
guard_list = { "[" ~ WHITESPACE* ~ (guard_specifier ~ ("," ~ WHITESPACE* ~ guard_specifier)*)? ~ WHITESPACE* ~ "]" }
guard_specifier = { IDENTIFIER ~ ("(" ~ WHITESPACE* ~ "not" ~ WHITESPACE* ~ ")")? } // Allows guardName(not)

// --- Actions / Guards / Invokes Blocks ---
actions_block = { "actions" ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | action_definition)* ~ WHITESPACE* ~ "}" }
action_definition = { "action" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ ";"? }

guards_block = { "guards" ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | guard_definition)* ~ WHITESPACE* ~ "}" }
guard_definition = { "guard" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ ";"? }

invokes_block = { "invokes" ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | invoke_definition)* ~ WHITESPACE* ~ "}" }
invoke_definition = { "invoke" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | invoke_property)* ~ WHITESPACE* ~ "}" }
invoke_property = _{ invoke_src | invoke_input | invoke_on_done | invoke_on_error }
invoke_src = { "src" ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ invoke_source_value ~ ";"? }
invoke_source_value = { (IDENTIFIER ~ "." ~ IDENTIFIER)
                       | STRING_LITERAL
                       | IDENTIFIER }
invoke_input = { "input" ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ object_literal ~ ";"? }
invoke_on_done = { "onDone" ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ transition_target_specifier ~ ";"? }
invoke_on_error = { "onError" ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ transition_target_specifier ~ ";"? }

// --- State Invokes ---
state_invoke = { "invoke" ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | state_invoke_property)* ~ WHITESPACE* ~ "}" }
state_invoke_property = _{ state_invoke_src | invoke_input | invoke_on_done | invoke_on_error }
state_invoke_src = { "src" ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ ("invokes" ~ ".")? ~ IDENTIFIER ~ ";"? }

// --- History Definition ---
history_definition = { "history" ~ WHITESPACE* ~ history_type? ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "target" ~ WHITESPACE* ~ IDENTIFIER ~ ";"? }
history_type = { "shallow" | "deep" }

// --- Services Block ---
services_block = { "services" ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | service_item)* ~ WHITESPACE* ~ "}" }
service_item = _{ annotation* ~ (interface_definition | service_definition) }

interface_definition = { "interface" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | method_definition)* ~ WHITESPACE* ~ "}" }
method_definition = { "method" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "(" ~ WHITESPACE* ~ parameter_list? ~ WHITESPACE* ~ ")" ~ WHITESPACE* ~ ("->" ~ WHITESPACE* ~ type_specifier)? ~ WHITESPACE* ~ (method_body | ";") }
parameter_list = { parameter_definition ~ ("," ~ WHITESPACE* ~ parameter_definition)* }
parameter_definition = { IDENTIFIER ~ ":" ~ WHITESPACE* ~ type_specifier ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ annotation* }
method_body = { "{" ~ annotation* ~ "}" }

service_definition = { "service" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ ("extends" ~ WHITESPACE* ~ IDENTIFIER)? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation)* ~ WHITESPACE* ~ "}" }

// --- Communication Block ---
communication_block = { "communication" ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | communication_item)* ~ WHITESPACE* ~ "}" }
communication_item = _{ annotation* ~ (protocol_definition | channel_definition | event_definition) }

protocol_definition = { "protocol" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ ";"? }
channel_definition = { "channel" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | channel_property)* ~ WHITESPACE* ~ "}" }
channel_property = _{ channel_description | channel_parameters }
channel_description = { "description" ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ STRING_LITERAL ~ ";"? }
channel_parameters = { "parameters" ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (parameter_definition ~ ("," ~ WHITESPACE* ~ parameter_definition)*)? ~ WHITESPACE* ~ "}" ~ ";"? }

event_definition = { "event" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | field_definition)* ~ WHITESPACE* ~ "}" }

// --- Actors Block ---
actors_block = { "actors" ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | actor_definition)* ~ WHITESPACE* ~ "}" }
actor_definition = { "actor" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ ";"? }

// --- Deployment Config Block ---
deployment_config_block = { "deployment_config" ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | deployment_item)* ~ WHITESPACE* ~ "}" }
deployment_item = _{ annotation* ~ (environment_definition | infrastructure_definition | deployment_definition) }

environment_definition = { "environment" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ environment_extends? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | environment_property)* ~ WHITESPACE* ~ "}" }
environment_extends = { "extends" ~ WHITESPACE* ~ IDENTIFIER }
environment_property = _{ environment_variables }
environment_variables = { "variables" ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ object_literal ~ ";"? }

infrastructure_definition = { "infrastructure" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ infrastructure_extends? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | infrastructure_property)* ~ WHITESPACE* ~ "}" }
infrastructure_extends = { "extends" ~ WHITESPACE* ~ IDENTIFIER }
infrastructure_property = _{ attribute_definition }
attribute_definition = { IDENTIFIER ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ literal_value ~ ";"? }

deployment_definition = { "deployment" ~ WHITESPACE* ~ IDENTIFIER ~ WHITESPACE* ~ numeric_id? ~ WHITESPACE* ~ "{" ~ WHITESPACE* ~ (COMMENT | WHITESPACE | annotation | deployment_property)* ~ WHITESPACE* ~ "}" }
deployment_property = _{ dep_target_env | dep_target_infra | dep_deployable | dep_replicas | dep_strategy | dep_config | dep_attribute }
dep_target_env = { "targetEnvironment" ~ WHITESPACE* ":" ~ WHITESPACE* ~ IDENTIFIER ~ ";"? }
dep_target_infra = { "targetInfrastructure" ~ WHITESPACE* ":" ~ WHITESPACE* ~ object_literal ~ ";"? }
dep_deployable = { "deployable" ~ WHITESPACE* ":" ~ WHITESPACE* ~ IDENTIFIER ~ ";"? }
dep_replicas = { "replicas" ~ WHITESPACE* ":" ~ WHITESPACE* ~ INTEGER_LITERAL ~ ";"? }
dep_strategy = { "strategy" ~ WHITESPACE* ":" ~ WHITESPACE* ~ STRING_LITERAL ~ ";"? }
dep_config = { "config" ~ WHITESPACE* ":" ~ WHITESPACE* ~ object_literal ~ ";"? }
dep_attribute = { attribute_definition }

// --- Type Specifiers ---
type_specifier = { list_specifier | optional_specifier | map_specifier | simple_specifier }
simple_specifier = { IDENTIFIER }
list_specifier = { "list" ~ "<" ~ type_specifier ~ ">" }
optional_specifier = { "optional" ~ "<" ~ type_specifier ~ ">" }
map_specifier = { "map" ~ "<" ~ type_specifier ~ "," ~ WHITESPACE* ~ type_specifier ~ ">" }

// --- Numeric ID ---
numeric_id = { "@id" ~ "(" ~ INTEGER_LITERAL ~ ")" }

// Helper for placeholders
any_content = _{ (COMMENT | WHITESPACE | (!"}" ~ inner ))* }

// --- Rule Reference ---
// The main rule the parser will start with.
ssot_entry_rule = _{ file } 