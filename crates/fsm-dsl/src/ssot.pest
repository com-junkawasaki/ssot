// ssot.pest - Grammar for SSOT FSM definition

// Basic whitespace and comments
// WHITESPACE = { (" " | "\t" | "\n" | "\r")+ } // Make WHITESPACE silent again
WHITESPACE = _{ (" " | "\t" | "\n" | "\r")+ } // Make WHITESPACE TRULY silent
COMMENT    = _{ ("#" | "//") ~ (!("\n" | "\r") ~ ANY)* }
// Revert optional_whitespace to simple silent rule
// optional_whitespace = _{ (WHITESPACE | COMMENT)* } // Keep COMMENT silent
optional_whitespace = _{ (WHITESPACE | COMMENT)* } // Corrected comment - this should be fine

// ====================================
//  Top Level Structure
// ====================================

// parser.rs expects `ssot_file` as the top rule
// Revert to simpler rule, relying on silent WHITESPACE
ssot_file = { SOI ~ file_id ~ package_decl? ~ import_decl* ~ top_level_item* ~ EOI }

file_id = { "@" ~ hex_literal ~ ";" }
hex_literal = @{ "0x" ~ ASCII_HEX_DIGIT+ }

package_decl = { "package" ~ package_name ~ ";" }
package_name = @{ ident ~ ("." ~ ident)* }

import_decl = { "import" ~ package_name ~ ";" }

// Updated: Added struct_def
top_level_item = { annotation | state_machine | struct_def }

// ====================================
//  Annotations
// ====================================

annotation = { "$" ~ ident ~ annotation_value? ~ ";" }
annotation_value = { "(" ~ annotation_value_inner? ~ ")" }
annotation_value_inner = { array_literal | literal | ident_list | ident }

literal = { string_literal | number_literal | boolean_literal }

string_literal = @{ "\"" ~ ( !("\\" | "\"") ~ ANY )* ~ "\"" }
number_literal = @{ "-"? ~ ASCII_DIGIT+ } // Corresponds to ast::AnnotationValue::NumberLiteral
boolean_literal = @{ "true" | "false" }
array_literal = { "[" ~ (string_literal ~ ("," ~ string_literal)*)? ~ "]" }
ident_list = { ident ~ ("," ~ ident)* }

// ====================================
//  Identifiers and Qualified Identifiers
// ====================================

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Represents either a simple ident or a qualified one like ns.ident
qualified_ident = { ident ~ ("." ~ ident)? }

// ====================================
//  State Machine Definition
// ====================================

state_machine = { "stateMachine" ~ ident ~ "{" ~ WHITESPACE?
    ~ machine_item* // Allow machine items directly
    ~ WHITESPACE? ~ "}" }

// Updated: Added use_decl and context_block placeholder
machine_item = { annotation | states_block | events_block | transitions_block | context_block | use_decl }

// Added use declaration inside machine scope
use_decl = { "use" ~ WHITESPACE ~ qualified_ident ~ ";" }

// ====================================
//  States Block
// ====================================

states_block = { "states" ~ WHITESPACE? ~ "{" ~ WHITESPACE? ~ state_item* ~ WHITESPACE? ~ "}" }
state_item = { annotation* ~ ident ~ state_ordinal ~ state_body? ~ ";" }
state_ordinal = { "@" ~ integer_literal }
state_body = { "{" ~ WHITESPACE? ~ state_element* ~ WHITESPACE? ~ "}" }
state_element = { entry_action | exit_action | annotation }
entry_action = { "entry" ~ ":" ~ qualified_ident ~ ";" } // Use qualified_ident
exit_action = { "exit" ~ ":" ~ qualified_ident ~ ";" }  // Use qualified_ident

// ====================================
//  Events Block
// ====================================

events_block = { "events" ~ "{" ~ event_item* ~ "}" }
// Updated: Allow use_decl and annotations within events block
event_item = { annotation | event_struct | use_decl }

event_struct = { annotation* ~ "event" ~ ident ~ event_ordinal ~ event_body? ~ ";" }
event_ordinal = { "@" ~ integer_literal }
event_body = { "{" ~ WHITESPACE? ~ (annotation | event_field)* ~ WHITESPACE? ~ "}" }
event_field = { (ident ~ ":" ~ field_type ~ field_ordinal ~ ";") | (ident ~ ":" ~ field_type ~ ";") } // Explicit cases
field_ordinal = { "@" ~ integer_literal } // Simpler definition

field_type = @{ !("@") ~ (primitive_type | list_type | type_identifier) }
primitive_type = { "Void" | "Bool" | "Int8" | "Int16" | "Int32" | "Int64" | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "Float32" | "Float64" | "Text" | "Data" }
list_type = { "List" ~ "<" ~ field_type ~ ">" }
type_identifier = { qualified_ident } // Use qualified_ident

// ====================================
//  Struct Definition (New)
// ====================================

struct_def = { annotation* ~ "struct" ~ ident ~ struct_body? ~ ";" }
struct_body = { "{" ~ WHITESPACE? ~ struct_field* ~ WHITESPACE? ~ "}" } // Reverted
// Reuse event_field structure for struct fields
struct_field = { event_field }

// ====================================
//  Transitions Block
// ====================================

// Keep outer WHITESPACE? for clarity around {}
transitions_block = { "transitions" ~ WHITESPACE? ~ "{" ~ WHITESPACE? ~ transition_item* ~ WHITESPACE? ~ "}" }

// transition_item = { annotation* ~ WHITESPACE? ~ transition_header ~ WHITESPACE? ~ transition_body ~ WHITESPACE? ~ ";" } // Revert whitespace changes
transition_item = { annotation* ~ transition_header ~ transition_body ~ ";" }

// transition_header = { ("transition" ~ WHITESPACE ~ ident ~ WHITESPACE)? ~ "from" ~ WHITESPACE ~ ident ~ WHITESPACE ~ "to" ~ WHITESPACE ~ ident } // Revert whitespace changes
transition_header = { ("transition" ~ ident)? ~ "from" ~ ident ~ "to" ~ ident } // Rely on silent WHITESPACE

// Keep outer WHITESPACE? for clarity around {}
transition_body = { "{" ~ WHITESPACE? ~ transition_element* ~ WHITESPACE? ~ "}" }

// transition_element = { WHITESPACE? ~ ( on_trigger | guard_condition | action_effect | annotation ) ~ WHITESPACE? } // Revert whitespace changes
transition_element = { on_trigger | guard_condition | action_effect | annotation }

// on_trigger = { "on" ~ transition_ordinal ~ WHITESPACE ~ qualified_ident ~ WHITESPACE? ~ ";" } // Revert whitespace changes
on_trigger = { "on" ~ transition_ordinal ~ qualified_ident ~ ";" }
// guard_condition = { "guard" ~ transition_ordinal ~ WHITESPACE ~ qualified_ident ~ WHITESPACE? ~ ";" } // Revert whitespace changes
guard_condition = { "guard" ~ transition_ordinal ~ qualified_ident ~ ";" }
// action_effect = { "action" ~ transition_ordinal ~ WHITESPACE ~ qualified_ident ~ WHITESPACE? ~ ";" } // Revert whitespace changes
action_effect = { "action" ~ transition_ordinal ~ qualified_ident ~ ";" }
// transition_ordinal = { WHITESPACE? ~ "@" ~ WHITESPACE? ~ integer_literal } // Revert whitespace changes
transition_ordinal = { "@" ~ integer_literal } // Rely on silent WHITESPACE

// ====================================
//  Context Block (Placeholder)
// ====================================

context_block = { "context" ~ "{" ~ WHITESPACE? ~ context_field* ~ WHITESPACE? ~ "}" } // Reverted
context_field = { event_field } // Reuse event_field structure for now

// ====================================
//  Basic Tokens
// ====================================

integer_literal = @{ ASCII_DIGIT+ }

// Implicit rules handled by Pest based on usage:
// WHITESPACE, COMMENT, SOI, EOI