// ssot.pest - Grammar for SSOT FSM definition

// Basic whitespace and comments (Silent rules)
WHITESPACE = _{ (" " | "\t" | "\n" | "\r")+ }
// Allow both # and // style comments
COMMENT    = _{ ("#" | "//") ~ (!("\n" | "\r") ~ ANY)* }
// Revert optional_whitespace to simple silent rule
optional_whitespace = _{ (WHITESPACE | COMMENT)* } // Restore SILENT

// ====================================
//  Top Level Structure
// ====================================

ssot_file = { SOI ~ file_id ~ package_decl? ~ (top_level_item | import_decl)* ~ EOI }

file_id = { "@" ~ hex_literal ~ ";" }
hex_literal = @{ "0x" ~ ASCII_HEX_DIGIT+ }

package_decl = { "package" ~ WHITESPACE ~ package_name ~ ";" }
package_name = @{ ident ~ ("." ~ ident)* }

import_decl = { "import" ~ WHITESPACE ~ package_name ~ ";" } // Added import declaration

top_level_item = { annotation | state_machine }

// ====================================
//  Annotations
// ====================================

annotation = { "$" ~ ident ~ annotation_value? ~ ";" }
annotation_value = { "(" ~ annotation_value_inner? ~ ")" }
annotation_value_inner = { array_literal | literal | ident }

literal = { string_literal | number_literal | boolean_literal }

string_literal = @{ "\"" ~ ( !("\\" | "\"") ~ ANY )* ~ "\"" }
number_literal = @{ "-"? ~ ASCII_DIGIT+ }
boolean_literal = @{ "true" | "false" }
array_literal = { "[" ~ (string_literal ~ ("," ~ string_literal)*)? ~ "]" }

// ====================================
//  Identifiers and Qualified Identifiers
// ====================================

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// New: Represents either a simple ident or a qualified one like ns.ident
qualified_ident = @{ ident ~ (".." ~ ident)? } // Simplified: Using ".." as separator to avoid grammar conflict with floats for now
                                              // Ideally, we'd use "." but need careful grammar design.
                                              // Or handle potential ambiguity in the parser logic.
                                              // Let's try sticking with "." and see if Pest handles it.
qualified_ident = @{ ident ~ ("." ~ ident)? } // Reverted to using "."

// ====================================
//  State Machine Definition
// ====================================

state_machine = { "stateMachine" ~ WHITESPACE ~ ident ~ "{" ~ WHITESPACE?
    ~ machine_item* // Allow machine items directly
    ~ WHITESPACE? ~ "}" }

// Updated: Added use_decl
machine_item = { annotation | states_block | events_block | transitions_block | context_block | use_decl }

// Added use declaration inside machine scope
use_decl = { "use" ~ WHITESPACE ~ qualified_ident ~ ";" } 

// ====================================
//  States Block
// ====================================

states_block = { "states" ~ WHITESPACE? ~ "{" ~ WHITESPACE? ~ state_item* ~ WHITESPACE? ~ "}" }
state_item = { annotation* ~ ident ~ state_ordinal ~ state_body? ~ ";" }
state_ordinal = { "@" ~ integer_literal }
state_body = { "{" ~ WHITESPACE? ~ state_element* ~ WHITESPACE? ~ "}" }
state_element = { entry_action | exit_action | annotation }
entry_action = { "entry" ~ ":" ~ qualified_ident ~ ";" } // Changed to qualified_ident
exit_action = { "exit" ~ ":" ~ qualified_ident ~ ";" }  // Changed to qualified_ident

// ====================================
//  Events Block
// ====================================

events_block = { "events" ~ WHITESPACE? ~ "{" ~ WHITESPACE? ~ event_item* ~ WHITESPACE? ~ "}" }
// Updated: Added use_decl within events
event_item = { event_struct | use_decl }

event_struct = { annotation* ~ "event" ~ WHITESPACE ~ ident ~ event_ordinal ~ event_body? ~ ";" }
event_ordinal = { "@" ~ integer_literal }
event_body = { "{" ~ WHITESPACE? ~ event_field* ~ WHITESPACE? ~ "}" }
event_field = { annotation* ~ ident ~ ":" ~ field_type ~ field_ordinal ~ ";" }
field_ordinal = { "@" ~ integer_literal }

field_type = { primitive_type | list_type | type_identifier }
primitive_type = @{ "Void" | "Bool" | "Int8" | "Int16" | "Int32" | "Int64" | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "Float32" | "Float64" | "Text" | "Data" }
list_type = { "List" ~ "<" ~ field_type ~ ">" }
type_identifier = { qualified_ident } // Changed to qualified_ident

// ====================================
//  Transitions Block
// ====================================

transitions_block = { "transitions" ~ WHITESPACE? ~ "{" ~ WHITESPACE? ~ transition_item* ~ WHITESPACE? ~ "}" }
transition_item = { annotation* ~ transition_header ~ transition_body ~ ";" }
transition_header = { ("transition" ~ WHITESPACE ~ ident ~ WHITESPACE)? ~ "from" ~ WHITESPACE ~ ident ~ WHITESPACE ~ "to" ~ WHITESPACE ~ ident }
transition_body = { "{" ~ WHITESPACE? ~ transition_element* ~ WHITESPACE? ~ "}" }
transition_element = { on_trigger | guard_condition | action_effect | annotation }

on_trigger = { "on" ~ transition_ordinal ~ qualified_ident ~ ";" }       // Changed to qualified_ident
guard_condition = { "guard" ~ transition_ordinal ~ qualified_ident ~ ";" } // Changed to qualified_ident
action_effect = { "action" ~ transition_ordinal ~ qualified_ident ~ ";" } // Changed to qualified_ident
transition_ordinal = { WHITESPACE ~ "@" ~ integer_literal }

// ====================================
//  Context Block (Placeholder)
// ====================================

context_block = { "context" ~ WHITESPACE? ~ "{" ~ WHITESPACE? ~ context_field* ~ WHITESPACE? ~ "}" }
context_field = { event_field } // Reuse event_field structure for now

// ====================================
//  Basic Tokens & Whitespace
// ====================================

integer_literal = @{ ASCII_DIGIT+ }

// Define WHITESPACE and COMMENT to be skipped implicitly by Pest
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ line_comment | block_comment }
line_comment = { "//" ~ (!"\n" ~ ANY)* }
block_comment = { "/*" ~ ( block_comment | (!"*/" ~ ANY) )* ~ "*/" }