/*
Basic grammar structure for the SSOT DSL.
We'll progressively build this based on DSL.md.
*/

// Define whitespace and comments (ignored by parser rules)
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }
ignored = _{ WHITESPACE | COMMENT } // Added back

// Basic building blocks
identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
string_literal = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
integer_literal = @{ ("-")? ~ ASCII_DIGIT+ }
hex_literal = @{ "0x" ~ ASCII_HEX_DIGIT+ }
duration_literal = @{ ASCII_DIGIT+ ~ ("ms" | "s" | "m" | "h") }

// Placeholder for the main parsing rule
// file = { SOI ~ (COMMENT | PUSH(definition))* ~ EOI } // Old rule
file = {
    SOI ~
    ignored* ~ // Allow leading ignored
    ( // Group for definitions
        PUSH(definition) ~
        ignored* // Allow ignored after definition
    )* ~ // Repeat zero or more times
    EOI
}

// Updated top-level definitions rule
definition = { file_id | import_statement | types_block | actors_block | communication_block | services_block | machines_block | deployment_config_block | annotation }

// file_id = { "@" ~ hex_literal ~ ";" } // Keep the reverted change for now
file_id = { "file_id" ~ ":" ~ hex_literal ~ ";" }
import_statement = { "import" ~ string_literal ~ ";" }

// --- Block Definitions ---

types_block = { annotation* ~ "types" ~ "{" ~ type_definition* ~ "}" }
type_definition = _{ struct_definition | enum_definition }

actors_block = { annotation* ~ "actors" ~ "{" ~ "}" } // TODO: actor_definition* Placeholder
communication_block = { annotation* ~ "communication" ~ "{" ~ "}" } // TODO: communication_definition* Placeholder
services_block = { annotation* ~ "services" ~ "{" ~ "}" } // TODO: service_definition* Placeholder
machines_block = { annotation* ~ "machines" ~ "{" ~ machine_definition* ~ "}" }
deployment_config_block = { annotation* ~ "deployment_config" ~ "{" ~ "}" } // TODO: deployment_definition* Placeholder

// --- Type Definitions ---

struct_definition = { annotation* ~ "struct" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ field_definition* ~ "}" }
field_definition = { annotation* ~ identifier ~ ":" ~ type_specifier ~ "@id(" ~ integer_literal ~ ")" ~ annotation* ~ ";" }

enum_definition = { annotation* ~ "enum" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ enum_variant* ~ "}" }
enum_variant = { annotation* ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ annotation* ~ ";" }

// Updated type specifiers rule
type_specifier = _{ list_type | optional_type | simple_type }

simple_type = { identifier }
list_type = { "list" ~ "<" ~ type_specifier ~ ">" }
optional_type = { "optional" ~ "<" ~ type_specifier ~ ">" }

// Updated annotation rules
annotation = _{ description_annotation | validate_annotation | db_annotation | meta_annotation | generic_kv_annotation | generic_flag_annotation }

description_annotation = { "$" ~ ("description") ~ "(" ~ string_literal ~ ")" ~ ";" }
validate_annotation = { "$" ~ ("validate") ~ "(" ~ annotation_args? ~ ")" ~ ";" }
db_annotation = { "$" ~ ("db") ~ "(" ~ annotation_args? ~ ")" ~ ";" }
meta_annotation = { "$" ~ ("meta") ~ "(" ~ annotation_args? ~ ")" ~ ";" }
generic_kv_annotation = { "$" ~ identifier ~ "(" ~ annotation_value ~ ")" }
generic_flag_annotation = { "$" ~ identifier ~ ";" }
// Add specific flag annotations for states
initial_annotation = { "$" ~ "initial" ~ ";" }
final_annotation = { "$" ~ "final" ~ ";" }
parallel_annotation = { "$" ~ "parallel" ~ ";" } // Added parallel flag

// Rule for key-value arguments inside annotations like $validate, $db, $meta
annotation_args = { annotation_arg ~ ("," ~ annotation_arg)* }
annotation_arg = { identifier ~ ":" ~ annotation_value }

// Updated annotation values (needs expansion for bool, list, object)
annotation_value = _{ string_literal | integer_literal } // TODO: | boolean_literal | list_literal | object_literal
// boolean_literal = { "true" | "false" }
// list_literal = { "[" ~ annotation_value ~ ("," ~ annotation_value)* ~ "]" }
// object_literal = { "{" ~ annotation_args? ~ "}" } // For nested structures like foreignKey or policies

// --- Machine Definitions (Basic) ---

machine_definition = { annotation* ~ "machine" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ machine_element* ~ "}" }
// Updated placeholder for elements inside a machine block
machine_element = { context_definition | states_definition | actions_definition | guards_definition | invokes_definition } // Added invokes

context_definition = { annotation* ~ "context" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ context_field_definition* ~ "}" }
// Context fields are similar to struct fields, but might have $default
context_field_definition = { annotation* ~ identifier ~ ":" ~ type_specifier ~ "@id(" ~ integer_literal ~ ")" ~ annotation* ~ ";" }

// --- State Machine States Definitions (Added) ---

states_definition = { annotation* ~ "states" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ state_definition* ~ "}" }

state_definition = { annotation* ~ "state" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ state_element* ~ "}" }

// Placeholder for elements inside a state block
state_element = { initial_annotation | final_annotation | parallel_annotation | on_entry | on_exit | on_transition | after_transition | state_invoke | states_definition | history_definition } // Added parallel flag

// Basic event transition
on_transition = { "on" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ transition_details ~ ";" }

// --- Delayed Transition (Added) ---
after_transition = { "after" ~ duration_literal ~ "@id(" ~ integer_literal ~ ")" ~ transition_details ~ ";" }

// --- Entry/Exit Actions (Added) ---
on_entry = { "onEntry" ~ "{" ~ action_ref* ~ "}" ~ ";" }
on_exit = { "onExit" ~ "{" ~ action_ref* ~ "}" ~ ";" }

// Details following the transition keyword
transition_details = { "transition" ~ identifier ~ transition_block? }
transition_block = { "{" ~ (action_ref | guard_ref)* ~ "}" }
action_ref = { "action" ~ identifier ~ ";" } // Assuming actions are predefined identifiers for now
guard_ref = { "guard" ~ identifier ~ ";" }  // Assuming guards are predefined identifiers for now

// --- Action Definitions (Added) ---
actions_definition = { annotation* ~ "actions" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ action_definition* ~ "}" }
action_definition = { annotation* ~ "action" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ ";" } // Simple identifier-based for now

// --- Guard Definitions (Added) ---
guards_definition = { annotation* ~ "guards" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ guard_definition* ~ "}" }
guard_definition = { annotation* ~ "guard" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ ";" } // Simple identifier-based for now

// --- Invoke Definitions (Added) ---
invokes_definition = { annotation* ~ "invokes" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ invoke_definition* ~ "}" }

// invoke Name @id(N) { src: Source; input?: {...}; onDone?: ...; onError?: ...; }
invoke_definition = { annotation* ~ "invoke" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ invoke_body ~ ";" }

// Body of the invoke definition: { src: ... }
invoke_body = { "{" ~ invoke_src ~ invoke_param* ~ "}" } 

// Source of the invocation (service.method, "string", MachineName)
invoke_src = { "src" ~ ":" ~ (service_method_ref | string_literal | identifier) ~ ";" } // Allow identifier for MachineName
service_method_ref = { identifier ~ "." ~ identifier } 

// Other invoke parameters (input, onDone, onError) - Very basic placeholders for now
invoke_param = { (input_mapping | on_done | on_error) }
input_mapping = { "input" ~ ":" ~ object_literal ~ ";" } // Placeholder: simple object literal
on_done = { "onDone" ~ ":" ~ transition_ref ~ ";" } // Placeholder: references a transition (needs defining) 
on_error = { "onError" ~ ":" ~ transition_ref ~ ";" } // Placeholder: references a transition

transition_ref = { identifier } // Placeholder: just the target state name for now
object_literal = { "{" ~ annotation_args? ~ "}" } // Reuse annotation_args for key:value structure (basic)

// --- State Invocation (Added) ---
// invoke StateInvokeName @id(N) { src: invokes.DefinedInvokeName; input?: {...}; onDone?: ...; onError?: ... }
state_invoke = { "invoke" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ state_invoke_body ~ ";" }

// Similar to invoke_body but src must reference a defined invoke
state_invoke_body = { "{" ~ state_invoke_src ~ invoke_param* ~ "}" } 
state_invoke_src = { "src" ~ ":" ~ invoke_ref ~ ";" } // Reference defined invoke: invokes.Name
invoke_ref = { "invokes" ~ "." ~ identifier }

// --- History State Definition (Added) ---
// history [shallow|deep] @id(N) target DefaultTargetState;
history_definition = { "history" ~ history_type ~ "@id(" ~ integer_literal ~ ")" ~ "target" ~ identifier ~ ";" }
history_type = { "shallow" | "deep" }

// TODO: Add rules for all other elements from DSL.md:
// - enums, machines, services, interfaces, protocols, actors, channels, events
// - context, states, transitions (on, after), actions, guards, invokes
// - deployment_config, environment, infrastructure, deployment
// - annotations ($description, $initial, $final, $db, $validate, etc.)
// - detailed type specifiers (list, optional, map)
// - expressions within guards/actions (if applicable to parsing stage)
// - nested structures and blocks 