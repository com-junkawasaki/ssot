/*
Basic grammar structure for the SSOT DSL.
We'll progressively build this based on DSL.md.
*/

// Define whitespace and comments (ignored by parser rules)
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }
ignored = _{ WHITESPACE | COMMENT }

// Basic building blocks
identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
string_literal = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
integer_literal = @{ ("-")? ~ ASCII_DIGIT+ }
hex_literal = @{ "0x" ~ ASCII_HEX_DIGIT+ }
duration_literal = @{ ASCII_DIGIT+ ~ ("ms" | "s" | "m" | "h") }

// Placeholder for the main parsing rule
file = { SOI ~ ignored* ~ definition* ~ ignored* ~ EOI }

// Updated top-level definitions rule
// definition = { file_id | import_statement | types_block | actors_block | communication_block | services_block /* | machines_block */ | deployment_config_block | annotation }
// definition = { file_id | import_statement | types_block | actors_block | communication_block | services_block /* | machines_block */ | deployment_config_block | annotation } // machines_block commented out
definition = { file_id | import_statement | types_block | actors_block | communication_block | services_block | machines_block | deployment_config_block | annotation } // machines, services, communication commented out

file_id = { "file_id" ~ ":" ~ hex_literal ~ ";" }
import_statement = { "import" ~ string_literal ~ ";" }

// --- Block Definitions ---

types_block = { annotation* ~ "types" ~ "{" ~ type_definition* ~ "}" }
type_definition = _{ struct_definition | enum_definition }

actors_block = { annotation* ~ "actors" ~ "{" ~ actor_definition* ~ "}" }

communication_block = { annotation* ~ "communication" ~ "{" ~ communication_item* ~ "}" }
services_block = { annotation* ~ "services" ~ "{" ~ service_item* ~ "}" }
machines_block = { annotation* ~ "machines" ~ "{" ~ machine_definition* ~ "}" }
deployment_config_block = { annotation* ~ "deployment_config" ~ "{" ~ deployment_item* ~ "}" }
deployment_item = { environment_definition | infrastructure_definition | deployment_definition }

// --- Type Definitions ---

struct_definition = { annotation* ~ "struct" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ field_definition* ~ "}" }
field_definition = { annotation* ~ identifier ~ ":" ~ type_specifier ~ "@id(" ~ integer_literal ~ ")" ~ annotation* ~ ";" }

enum_definition = { annotation* ~ "enum" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ enum_variant* ~ "}" }
enum_variant = { annotation* ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ annotation* ~ ";" }

// Updated type specifiers rule
type_specifier = _{ list_type | optional_type | map_type | simple_type }

simple_type = { identifier }
list_type = { "list" ~ "<" ~ type_specifier ~ ">" }
optional_type = { "optional" ~ "<" ~ type_specifier ~ ">" }
map_type = { "map" ~ "<" ~ type_specifier ~ "," ~ type_specifier ~ ">" }

// Updated annotation rules
annotation = { dollar_annotation }

dollar_annotation = {
    description_annotation |
    validate_annotation |
    db_annotation |
    meta_annotation |
    implements_annotation |
    channel_annotation |
    initial_annotation |
    final_annotation |
    parallel_annotation |
    allowed_actors_annotation |
    protocol_annotation |
    communicates_with_annotation |
    publishes_annotation |
    subscribes_annotation |
    route_annotation |
    output_directive_annotation |
    generic_kv_annotation |
    generic_flag_annotation
}

// Capture key and value/args explicitly (Using workaround for key:(literal))
description_annotation = { "$" ~ "description" ~ "(" ~ (desc_value:string_literal) ~ ")" ~ ";" }
validate_annotation = { "$" ~ "validate" ~ "(" ~ annotation_args? ~ ")" ~ ";" }
db_annotation = { "$" ~ "db" ~ "(" ~ annotation_args? ~ ")" ~ ";" }
meta_annotation = { "$" ~ "meta" ~ "(" ~ annotation_args? ~ ")" ~ ";" }
initial_annotation = { "$" ~ "initial" ~ "(" ~ value:identifier ~ ")" ~ ";" }
final_annotation = { "$" ~ "final" ~ ";" }
parallel_annotation = { "$" ~ "parallel" ~ ";" }
allowed_actors_annotation = { "$" ~ "allowedActors" ~ "(" ~ value:identifier_list ~ ")" ~ ";" }
protocol_annotation = { "$" ~ "protocol" ~ "(" ~ value:identifier ~ ")" ~ ";" }
communicates_with_annotation = { "$" ~ "communicatesWith" ~ "(" ~ service:identifier ~ "using" ~ protocol:identifier ~ ")" ~ ";" }
publishes_annotation = { "$" ~ "publishes" ~ "(" ~ value:identifier ~ ")" ~ ";" }
subscribes_annotation = { "$" ~ "subscribes" ~ "(" ~ value:identifier ~ ")" ~ ";" }
route_annotation = { "$" ~ "route" ~ "(" ~ args:annotation_args ~ ")" ~ ";" }
output_directive_annotation = { "$" ~ key:(identifier ~ "_" ~ "out") ~ "(" ~ value:string_literal ~ ")" ~ ";" }
implements_annotation = { "$" ~ "implements" ~ "(" ~ value:identifier ~ ")" ~ ";" }
channel_annotation = { "$" ~ "channel" ~ "(" ~ value:identifier ~ ")" ~ ";" }

generic_kv_annotation = { "$" ~ key:identifier ~ "(" ~ value:annotation_value ~ ")" ~ ";" }
generic_flag_annotation = { "$" ~ key:identifier ~ ";" }

// Rule for key-value arguments inside annotations like $validate, $db, $meta, $route
annotation_args = { annotation_arg ~ ("," ~ annotation_arg)* }
annotation_arg = { identifier ~ ":" ~ annotation_value }

// Updated annotation values (needs expansion for bool, list, object)
annotation_value = _{ string_literal | integer_literal | boolean_literal | list_literal | object_literal }
boolean_literal = { "true" | "false" }
list_literal = { "[" ~ (annotation_value ~ ("," ~ annotation_value)*)? ~ "]" }
object_literal = { "{" ~ annotation_args? ~ "}" }

// --- New Specific Annotation Rules ---
identifier_list = { identifier ~ ("," ~ identifier)* }

// --- Machine Definitions (Basic) ---
machine_definition = { annotation* ~ "machine" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ machine_element* ~ "}" }
machine_element = { context_definition | states_definition | actions_definition | guards_definition | invokes_definition }

context_definition = { annotation* ~ "context" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ context_field_definition* ~ "}" }
context_field_definition = { annotation* ~ identifier ~ ":" ~ type_specifier ~ "@id(" ~ integer_literal ~ ")" ~ annotation* ~ ";" }

// --- State Machine States Definitions (Added) ---

states_definition = { annotation* ~ "states" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ state_definition* ~ "}" }

state_definition = { annotation* ~ "state" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ state_element* ~ "}" }

state_element = { initial_annotation | final_annotation | parallel_annotation | on_entry | on_exit | on_transition | after_transition | state_invoke | states_definition | history_definition }

on_transition = { "on" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ transition_details ~ ";" }

after_transition = { "after" ~ duration_literal ~ "@id(" ~ integer_literal ~ ")" ~ transition_details ~ ";" }

on_entry = { "onEntry" ~ "{" ~ action_ref* ~ "}" ~ ";" }
on_exit = { "onExit" ~ "{" ~ action_ref* ~ "}" ~ ";" }

transition_details = { "transition" ~ transition_target ~ transition_block? }

transition_target = { qualified_history_target | current_history_target | state_name_target }
state_name_target = { identifier }
current_history_target = { "." ~ "history" }
qualified_history_target = { identifier ~ "." ~ "history" }

transition_block = { "{" ~ (action_ref | guard_ref)* ~ "}" }
action_ref = { "action" ~ identifier ~ ";" }
guard_ref = { "guard" ~ identifier ~ ";" }

actions_definition = { annotation* ~ "actions" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ action_definition* ~ "}" }
action_definition = { annotation* ~ "action" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ ";" }

guards_definition = { annotation* ~ "guards" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ guard_definition* ~ "}" }
guard_definition = { annotation* ~ "guard" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ ";" }

invokes_definition = { annotation* ~ "invokes" ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ invoke_definition* ~ "}" }

invoke_definition = { annotation* ~ "invoke" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ invoke_body ~ ";" }

invoke_body = { "{" ~ invoke_src ~ invoke_param* ~ "}" }
invoke_src = { "src" ~ ":" ~ (service_method_ref | string_literal | identifier) ~ ";" }
service_method_ref = { identifier ~ "." ~ identifier }

invoke_param = { (input_mapping | on_done | on_error) }
input_mapping = { "input" ~ ":" ~ object_literal ~ ";" }
on_done = { "onDone" ~ ":" ~ invoke_transition_details ~ ";" }
on_error = { "onError" ~ ":" ~ invoke_transition_details ~ ";" }

invoke_transition_details = { transition_target ~ transition_block? }

state_invoke = { "invoke" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ state_invoke_body ~ ";" }

state_invoke_body = { "{" ~ state_invoke_src ~ invoke_param* ~ "}" }
state_invoke_src = { "src" ~ ":" ~ invoke_ref ~ ";" }
invoke_ref = { "invokes" ~ "." ~ identifier }

history_definition = { "history" ~ history_type ~ "@id(" ~ integer_literal ~ ")" ~ "target" ~ identifier ~ ";" }
history_type = { "shallow" | "deep" }

service_item = { interface_definition | service_definition }
interface_definition = { annotation* ~ "interface" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ method_definition* ~ "}" }

method_definition = { annotation* ~ "method" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "(" ~ parameter_list? ~ ")" ~ method_return? ~ method_body? ~ ";" }
parameter_list = { parameter ~ ("," ~ parameter)* }
parameter = { identifier ~ ":" ~ type_specifier ~ ("@id(" ~ integer_literal ~ ")")? }
method_return = { "->" ~ type_specifier }
method_body = { "{" ~ annotation* ~ "}" }

service_definition = { annotation* ~ "service" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ service_extends? ~ service_body }
service_extends = { "extends" ~ identifier }
service_body = { "{" ~ service_element* ~ "}" }
service_element = { annotation }

communication_item = { protocol_definition | channel_definition | event_definition }
protocol_definition = { annotation* ~ "protocol" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ protocol_body ~ ";" }
protocol_body = { "{" ~ annotation* ~ "}" }

channel_definition = { annotation* ~ "channel" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ channel_body ~ ";" }
channel_body = { "{" ~ channel_element* ~ "}" }
channel_element = { description_element | parameters_element | annotation }
description_element = { "description" ~ ":" ~ string_literal ~ ";" }
parameters_element = { "parameters" ~ ":" ~ object_literal ~ ";" }

event_definition = { annotation* ~ "event" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ "{" ~ event_field_definition* ~ "}" }
event_field_definition = { field_definition }

actor_definition = { annotation* ~ "actor" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ actor_body ~ ";" }
actor_body = { "{" ~ annotation* ~ "}" }

environment_definition = { annotation* ~ "environment" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ environment_extends? ~ environment_body ~ ";" }
environment_extends = { "extends" ~ identifier }
environment_body = { "{" ~ environment_element* ~ "}" }
environment_element = { variables_element | annotation }
variables_element = { "variables" ~ ":" ~ object_literal ~ ";" }

infrastructure_definition = { annotation* ~ "infrastructure" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ infrastructure_extends? ~ infrastructure_body ~ ";" }
infrastructure_extends = { "extends" ~ identifier }
infrastructure_body = { "{" ~ infrastructure_element* ~ "}" }
infrastructure_element = { attribute_kv_pair | annotation }
attribute_kv_pair = { identifier ~ ":" ~ annotation_value ~ ";" }

deployment_definition = { annotation* ~ "deployment" ~ identifier ~ "@id(" ~ integer_literal ~ ")" ~ deployment_body ~ ";" }
deployment_body = { "{" ~ deployment_element* ~ "}" }
deployment_element = { target_env_element | target_infra_element | deployable_element | attribute_kv_pair | config_element | annotation }
target_env_element = { "targetEnvironment" ~ ":" ~ identifier ~ ";" }
target_infra_element = { "targetInfrastructure" ~ ":" ~ object_literal ~ ";" }
deployable_element = { "deployable" ~ ":" ~ identifier ~ ";" }
config_element = { "config" ~ ":" ~ object_literal ~ ";" }

// TODO: Add rules for all other elements from DSL.md:
// - enums, machines, services, interfaces, protocols, actors, channels, events
// - context, states, transitions (on, after), actions, guards, invokes
// - deployment_config, environment, infrastructure, deployment
// - annotations ($description, $initial, $final, $db, $validate, etc.)
// - detailed type specifiers (list, optional, map)
// - expressions within guards/actions (if applicable to parsing stage)
// - nested structures and blocks 