// ssot.pest - Grammar for SSOT FSM definition

// Basic whitespace and comments (Silent rules)
WHITESPACE = _{ (" " | "\t" | "\n" | "\r")+ }
COMMENT    = _{ "#" ~ (!("\n" | "\r") ~ ANY)* } // Restore original
// Revert optional_whitespace to simple silent rule
optional_whitespace = _{ (WHITESPACE | COMMENT)* } // Restore SILENT

// --- Top Level ---
// parser.rs expects `ssot_file` as the top rule
ssot_file = { SOI ~ optional_whitespace ~ file_id? ~ package_decl? ~ top_level_item* ~ optional_whitespace ~ EOI }

top_level_item = { annotation | state_machine }

// Unique File ID (parser.rs expects rule `file_id`)
file_id = { "@" ~ hex_number ~ ";" ~ optional_whitespace }
hex_number = @{ "0x" ~ ASCII_HEX_DIGIT+ }

// Remove explicit syntax_annotation rule, handle as regular annotation if needed at top level
// syntax_annotation = { annotation } 

// Package Declaration (parser.rs expects rule `package_decl`)
package_decl = { "package" ~ identifier ~ ";" ~ optional_whitespace } // Simplified example

// --- State Machine Definition ---
// parser.rs expects `state_machine`
// Explicitly handle whitespace/comments before each item
// state_machine = { "stateMachine" ~ identifier ~ "{" ~ optional_whitespace ~ (optional_whitespace ~ state_machine_item)* ~ optional_whitespace ~ "}" ~ optional_whitespace }
// Revert to simpler structure
state_machine = { "stateMachine" ~ identifier ~ "{" ~ optional_whitespace ~ state_machine_item* ~ optional_whitespace ~ "}" ~ optional_whitespace }
state_machine_item = { annotation | state_enum | event_definitions | transitions_block }

// --- State Definitions ---
// parser.rs expects `state_enum` containing `state_variant`
// state_enum = { "states" ~ "{" ~ optional_whitespace ~ state_variant* ~ "}" ~ optional_whitespace }
state_enum = { "states" ~ "{" ~ optional_whitespace ~ state_variant* ~ optional_whitespace ~ "}" }
state_variant = { identifier ~ "@" ~ ordinal ~ ";" ~ optional_whitespace }

// --- Event Definitions --- (Restored)
// parser.rs expects `event_definitions` containing `event_struct`
// Allow optional whitespace (incl. comments) before the closing brace
// event_definitions = { "events" ~ "{" ~ optional_whitespace ~ (event_struct ~ optional_whitespace)* ~ optional_whitespace ~ "}" ~ optional_whitespace }
// event_definitions = { "events" ~ "{" ~ optional_whitespace ~ (event_struct ~ optional_whitespace)* ~ optional_whitespace ~ "}" }
// Remove optional_whitespace after event_struct in the loop
event_definitions = { "events" ~ "{" ~ optional_whitespace ~ event_struct* ~ optional_whitespace ~ "}" }

// parser.rs expects `event_struct` containing `event_field`
// Revert to original whitespace handling
// event_struct = { "event" ~ identifier ~ "@" ~ ordinal ~ "{" ~ optional_whitespace ~ (event_field ~ optional_whitespace)* ~ "}" ~ optional_whitespace }
// Consume whitespace before closing brace
event_struct = { "event" ~ identifier ~ "@" ~ ordinal ~ "{" ~ optional_whitespace ~ (event_field ~ optional_whitespace)* ~ optional_whitespace ~ "}" }

// parser.rs expects `event_field`
event_field = { identifier ~ "@" ~ ordinal ~ ":" ~ type ~ ";" ~ optional_whitespace }

// --- Transition Definitions ---
// Rule for the surrounding block
// Corrected version allowing whitespace/comments *before* each transition:
// transitions_block = { "transitions" ~ "{" ~ optional_whitespace ~ (optional_whitespace ~ transition_definition)* ~ optional_whitespace ~ "}" ~ optional_whitespace }
transitions_block = { "transitions" ~ "{" ~ optional_whitespace ~ (optional_whitespace ~ transition_definition)* ~ optional_whitespace ~ "}" }

// parser.rs expects `transition_definition` containing `transition_element`
// Try adding explicit optional_whitespace within transition_definition
// transition_definition = {
//     optional_whitespace ~ "transition" ~ optional_whitespace ~
//     identifier? ~ optional_whitespace ~
//     "from" ~ optional_whitespace ~ identifier ~ optional_whitespace ~
//     "to" ~ optional_whitespace ~ identifier ~ optional_whitespace ~
//     "{" ~ optional_whitespace ~ transition_element* ~ optional_whitespace ~ "}" ~ optional_whitespace
// }
// Consume whitespace before closing brace
transition_definition = {
    optional_whitespace ~ "transition" ~ optional_whitespace ~
    identifier? ~ optional_whitespace ~
    "from" ~ optional_whitespace ~ identifier ~ optional_whitespace ~
    "to" ~ optional_whitespace ~ identifier ~ optional_whitespace ~
    "{" ~ optional_whitespace ~ transition_element* ~ optional_whitespace ~ "}"
}
transition_element = { on_clause | guard_clause | action_clause | annotation }

on_clause = { "on" ~ optional_whitespace ~ "@" ~ optional_whitespace ~ ordinal ~ optional_whitespace ~ identifier ~ optional_whitespace ~ ";" ~ optional_whitespace }
guard_clause = { "guard" ~ optional_whitespace ~ "@" ~ optional_whitespace ~ ordinal ~ optional_whitespace ~ identifier ~ optional_whitespace ~ ";" ~ optional_whitespace }
action_clause = { "action" ~ optional_whitespace ~ "@" ~ optional_whitespace ~ ordinal ~ optional_whitespace ~ identifier ~ optional_whitespace ~ ";" ~ optional_whitespace }


// --- Common Elements ---
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
ordinal = @{ ASCII_DIGIT+ } // Simplified ordinal, parser expects u64
integer    = @{ "-"? ~ ASCII_DIGIT+ }
hex_literal = @{ "0x" ~ ASCII_HEX_DIGIT+ } // Used by parse_hex_literal indirectly via hex_number
string_literal = @{ "\"" ~ inner_string* ~ "\"" }
inner_string = { char_escape | (!("\"" | "\\") ~ ANY) }
char_escape    = { "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | ("u" ~ ASCII_HEX_DIGIT{4})) }
boolean_literal = @{ "true" | "false" }

// Types (parser.rs expects `primitive_type`, `list_type`, `identifier` for types)
type = { primitive_type | list_type | identifier }
primitive_type = @{ "Void" | "Bool" | "Int8" | "Int16" | "Int32" | "Int64" | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "Float32" | "Float64" | "Text" | "Data" }
list_type = { "List" ~ "(" ~ type ~ ")" }

// Annotations (parser.rs expects `annotation` containing `annotation_value`)
annotations = { annotation+ }
annotation = { "$" ~ identifier ~ annotation_value? ~ ";" ~ optional_whitespace }
annotation_value = { "(" ~ annotation_value_inner? ~ ")" }
annotation_value_inner = { identifier | literal_value | array_literal } // Grouping literals
literal_value = { number_literal | string_literal | boolean_literal }
number_literal = { integer } // parser expects i64, maps to this rule name
array_literal = { "[" ~ (string_literal ~ (optional_whitespace ~ "," ~ optional_whitespace ~ string_literal)*)? ~ optional_whitespace ~ "]" } // parser expects Vec<String>

// Implicit SOI and EOI