{
  "name": "ssot",
  "displayName": "ssot",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ssot"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ssot",
        "aliases": [
          "SSOT",
          "ssot"
        ],
        "extensions": [
          ".ssot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ssot",
        "scopeName": "source.ssot",
        "path": "./syntaxes/ssot.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^18.19.87",
    "@types/vscode": "^1.99.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
