// example.ssot
state Idle;

state Running {
    entry: log("Entered Running");
    exit: log("Exited Running");
}

state Error;

transition Start: Idle -> Running;
transition Fail: Running -> Error;
transition Recover: Error -> Idle; // Recover goes back to Idle

/*
  Another state definition
*/
state Finished;
transition Complete: Running -> Finished; // Running can also finish 